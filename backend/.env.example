# Copy to .env for running the API or worker outside Docker. Every setting is IM_<NAME>.
IM_DATABASE_URL=postgresql+psycopg://incident:incident@localhost:5432/incident
IM_WEBHOOK_TOKEN=change-me
IM_OIDC_ISSUER=http://localhost:8080/realms/incident
IM_OIDC_AUDIENCE=incident-manager
IM_PUBLIC_URL=http://localhost:5174
IM_GROUP_BY_LABELS=alertname,service

# Leave a channel's settings empty to disable it.
IM_SLACK_BOT_TOKEN=
IM_TELEGRAM_BOT_TOKEN=
IM_SMTP_HOST=
IM_SMTP_PORT=587
IM_SMTP_USERNAME=
IM_SMTP_PASSWORD=
IM_SMTP_FROM=incidents@example.com
